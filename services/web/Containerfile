# Tensorhelm portal: React build served by nginx on port 8080.
ARG NODE_IMAGE=registry.access.redhat.com/ubi9/nodejs-22:latest
ARG NGINX_IMAGE=registry.access.redhat.com/ubi9/nginx-124:latest

FROM ${NODE_IMAGE} AS build
WORKDIR /opt/app-root/src
COPY --chown=1001:0 package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY --chown=1001:0 . .
RUN npm run build

FROM ${NGINX_IMAGE}
USER 0
COPY nginx.conf /etc/nginx/nginx.conf
RUN mkdir -p /etc/tensorhelm && touch /etc/tensorhelm/proxy-secret.conf && chmod -R g+rwX /etc/tensorhelm
COPY --from=build /opt/app-root/src/dist /opt/app-root/src
USER 1001
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
